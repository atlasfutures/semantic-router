      },
      "turns": [
        { "role": "user", "text": "how many hits?" },
        { "role": "assistant", "text": "[tool_call grep] {\"q\": \"x\"}" },
        { "role": "user", "text": "[tool_result grep]\n3 hits" },
        { "role": "assistant", "text": "Three." },
        { "role": "user", "text": "and now?" }
