{
  "max_completion_tokens": 64,
  "messages": [
    {
      "role": "user",
      "content": "Return the sum of 2 and 3 as JSON."
    }
  ],
  "model": "conformance-chat-model",
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "sum_result",
      "schema": {
        "type": "object",
        "properties": {
          "sum": {
            "type": "integer"
          }
        },
        "required": [
          "sum"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
  },
  "temperature": 0
}
